# ========================================
# 🚂 Railway Environment Variables Template
# ========================================
# Copiar y configurar estas variables en Railway Dashboard → Service → Variables
# NO commitear este archivo con valores reales

# ========================================
# 🔐 Django Core Settings
# ========================================

# CRITICAL: Generate a unique secret key for production
# ⚠️ Run LOCALLY on your machine, NOT in Railway logs
# Command: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-CHANGE-THIS

# Django settings module for Railway
DJANGO_SETTINGS_MODULE=config.settings.railway

# Debug mode (always False in production)
DEBUG=False

# ========================================
# 🗄️ Database Configuration
# ========================================

# PostgreSQL connection (auto-generated by Railway)
# In Railway Dashboard: Link PostgreSQL service, then use:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Optional: Force SSL for database (default: False for Railway internal network)
# DATABASE_SSL_REQUIRE=False

# ========================================
# 🔴 Redis Configuration
# ========================================

# Redis connection for Celery and Channels (auto-generated by Railway)
# In Railway Dashboard: Link Redis service, then use:
REDIS_URL=${{Redis.REDIS_URL}}

# ========================================
# 🌐 URLs and Hosts
# ========================================

# Backend URL (Railway will provide a domain like: https://backend-production-xxxx.up.railway.app)
# Update this after first deployment or use custom domain
BACKEND_URL=https://your-backend.railway.app

# Frontend URL (Railway will provide a domain like: https://frontend-production-xxxx.up.railway.app)
# Update this after first deployment or use custom domain
FRONTEND_URL=https://your-frontend.railway.app

# Allowed hosts (comma-separated, no spaces)
# Include Railway domains and your custom domain
ALLOWED_HOSTS=*.railway.app,*.up.railway.app,app.mhsolucionesempresariales.com

# ========================================
# 👤 Superuser Configuration
# ========================================

# Superuser will be created automatically on first deployment
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@mhsoluciones.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisToAStrongPassword123!

# ========================================
# 📁 Storage Configuration
# ========================================

# Option 1: Railway Volumes (RECOMMENDED)
# Leave these variables EMPTY to use local storage with Railway Volumes
# Create a Volume in Railway: Settings → Volumes → New Volume
# - Name: media-storage
# - Mount Path: /app/mediafiles
# - Size: 10-50 GB

# Option 2: AWS S3 / Cloudflare R2
# Only configure these if you want to use S3-compatible storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=mh-soluciones-media
# AWS_S3_REGION_NAME=us-east-2
# AWS_S3_ENDPOINT_URL=  # Leave empty for AWS S3, set for Cloudflare R2

# ========================================
# 📧 Google Drive Integration
# ========================================

# Google Drive API credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Root folder ID in Google Drive where documents will be stored
# Get from Google Drive URL: https://drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-folder-id

# ========================================
# 📧 Email Configuration (Gmail SMTP)
# ========================================

# Email backend for production
# For Gmail SMTP, use: django.core.mail.backends.smtp.EmailBackend
# For console output (testing): django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP Configuration
# NOTE: You need to create an "App Password" in your Google Account
# Go to: https://myaccount.google.com/apppasswords
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to App Passwords and create a new password for "Mail"
# 3. Use the generated 16-character password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=noreply@mhsoluciones.com

# ========================================
# 📧 Email Notifications
# ========================================
# The system will automatically send emails for:
# - Calendar event creation, updates, and deletions
# - Task assignments
# - Task due date reminders (requires Celery periodic task)
# - Task reopened notifications
# - Task returned/rejected for revision

# ========================================
# 🔍 Monitoring & Error Tracking (Optional)
# ========================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========================================
# 🔄 Celery Configuration (Optional)
# ========================================

# Celery broker (uses REDIS_URL by default)
# CELERY_BROKER_URL=${{Redis.REDIS_URL}}
# CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}

# ========================================
# 🚀 Railway-Specific (Auto-Set)
# ========================================

# ⚠️ CRITICAL: PORT Configuration
# ========================================
# Railway automatically assigns a UNIQUE PORT to each service.
# 
# ❌ DO NOT SET PORT MANUALLY - This causes port conflicts!
# ✅ Let Railway assign PORT automatically per service
#
# When PORT is manually set as an environment variable:
# - Both Frontend and Backend get the SAME port (e.g., 8080)
# - This causes port conflicts and 502 Bad Gateway errors
# 
# Correct behavior (automatic):
# - Frontend gets PORT assigned by Railway (usually 80)
# - Backend gets PORT assigned by Railway (usually 8000)
# - Each service gets a DIFFERENT port automatically
#
# ❌ WRONG - Do not set these:
# PORT=8080  # This will cause conflicts!
# PORT=80    # This will cause conflicts!
# PORT=8000  # This will cause conflicts!
#
# ✅ CORRECT - Leave PORT unset, Railway will assign it
# (No PORT variable in Railway dashboard for either service)

# These are automatically set by Railway, do NOT configure manually:
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=xxxx
# RAILWAY_SERVICE_ID=xxxx
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app

# ========================================
# 📝 Notes
# ========================================

# 1. SECRET_KEY: MUST be unique and kept secret
# 2. DATABASE_URL & REDIS_URL: Use ${{Service.VARIABLE}} syntax in Railway
# 3. Superuser: Change password immediately after first login
# 4. Storage: Choose Railway Volumes OR S3/R2, not both
# 5. Google Drive: Required for document management features
# 6. Email: Optional, but recommended for password resets
# 7. Sentry: Highly recommended for production monitoring

# ========================================
# 🔒 Security Checklist
# ========================================

# Before going to production:
# ✅ Generate unique SECRET_KEY
# ✅ Change DJANGO_SUPERUSER_PASSWORD to strong password
# ✅ Configure ALLOWED_HOSTS with actual domains
# ✅ Set DEBUG=False
# ✅ Configure email backend for password resets
# ✅ Set up Sentry or error monitoring
# ✅ Create Railway Volume for media files
# ✅ Verify HTTPS is enabled (automatic in Railway)

