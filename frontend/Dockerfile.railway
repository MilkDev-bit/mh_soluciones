FROM node:20-alpine AS build

WORKDIR /app

# Build arguments for Railway
ARG VITE_API_BASE_URL
ARG VITE_WS_BASE_URL
ARG VITE_VAPID_PUBLIC_KEY

# Environment variables for build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_BASE_URL=$VITE_WS_BASE_URL
ENV VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production=false

# Copy source and build
COPY . .
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config optimized for Railway
COPY nginx.railway.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=build /app/dist /usr/share/nginx/html

# Railway uses PORT environment variable
# Create entrypoint script to handle dynamic port
RUN echo '#!/bin/sh' > /docker-entrypoint.d/99-railway-port.sh && \
    echo 'if [ -n "$PORT" ]; then' >> /docker-entrypoint.d/99-railway-port.sh && \
    echo '  sed -i "s/listen 80;/listen $PORT;/g" /etc/nginx/conf.d/default.conf' >> /docker-entrypoint.d/99-railway-port.sh && \
    echo 'fi' >> /docker-entrypoint.d/99-railway-port.sh && \
    chmod +x /docker-entrypoint.d/99-railway-port.sh

EXPOSE ${PORT:-80}

CMD ["nginx", "-g", "daemon off;"]
